# OpenAI-compatible base URL serving GPT-OSS 120B, e.g.
#   https://api.groq.com/openai/v1   https://openrouter.ai/api/v1   http://localhost:8000/v1 (vLLM)
GPT_OSS_ENDPOINT=
GPT_OSS_MODEL=gpt-oss-120b
# Required by hosted providers; leave blank for local servers.
GPT_OSS_API_KEY=

# Optional overrides (defaults shown)
# GPT_OSS_TEMPERATURE=0.7
# GPT_OSS_MAX_TOKENS=8192
# GPT_OSS_TIMEOUT=300
# HARNESS_BATCH_SIZE=10
# HARNESS_MAX_TOOL_STEPS=8
# HARNESS_MERGE_MAX_TOKENS=32768
